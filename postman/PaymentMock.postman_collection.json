{
  "info": {
    "name": "Mock Payment Gateway",
    "description": "Provider-agnostic mock payment gateway for end-to-end payment integration testing. Covers Mobile Money and Card payments, transaction/payout lifecycle, webhooks, the scenario engine, and admin/logging endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "apiKey", "value": "sandbox_test_key_12345", "type": "string" },
    { "key": "bearerToken", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "payoutId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Mobile Money Payment - Happy Path",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{$guid}}" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+254712345678\",\n  \"provider\": \"MTN\",\n  \"amount\": 1500.00,\n  \"currency\": \"KES\",\n  \"merchantReference\": \"ORDER-1001\",\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"jane@example.com\",\n  \"scenario\": \"HappyPath\",\n  \"callbackUrl\": \"https://webhook.site/your-unique-id\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/mobile-money", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payments", "mobile-money" ] }
          }
        },
        {
          "name": "Mobile Money Payment - Wrong PIN",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+256772345678\",\n  \"provider\": \"Airtel\",\n  \"amount\": 500.00,\n  \"currency\": \"UGX\",\n  \"merchantReference\": \"ORDER-1002\",\n  \"scenario\": \"WrongPin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/mobile-money", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payments", "mobile-money" ] }
          }
        },
        {
          "name": "Card Payment - Happy Path",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"4111111111111111\",\n  \"provider\": \"Visa\",\n  \"amount\": 2500.00,\n  \"currency\": \"USD\",\n  \"merchantReference\": \"ORDER-2001\",\n  \"expiryMonth\": \"12\",\n  \"expiryYear\": \"2030\",\n  \"cvv\": \"123\",\n  \"customerName\": \"John Smith\",\n  \"scenario\": \"HappyPath\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/card", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payments", "card" ] }
          }
        },
        {
          "name": "Card Payment - Invalid Card",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"5500005555555559\",\n  \"provider\": \"Mastercard\",\n  \"amount\": 800.00,\n  \"currency\": \"USD\",\n  \"merchantReference\": \"ORDER-2002\",\n  \"expiryMonth\": \"09\",\n  \"expiryYear\": \"2029\",\n  \"cvv\": \"456\",\n  \"scenario\": \"InvalidCard\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/card", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payments", "card" ] }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transaction by Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "transactions", "{{transactionId}}" ] }
          }
        },
        {
          "name": "Get Transaction Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/status", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "transactions", "{{transactionId}}", "status" ] }
          }
        },
        {
          "name": "Search Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?status=Completed&provider=MTN&page=1&pageSize=20",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "transactions" ],
              "query": [
                { "key": "status", "value": "Completed" },
                { "key": "provider", "value": "MTN" },
                { "key": "paymentMethod", "value": "", "disabled": true },
                { "key": "merchantReference", "value": "", "disabled": true },
                { "key": "fromDate", "value": "", "disabled": true },
                { "key": "toDate", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payouts",
      "item": [
        {
          "name": "Initiate Payout - Mobile Money",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"MobileMoney\",\n  \"provider\": \"MTN\",\n  \"amount\": 5000.00,\n  \"currency\": \"KES\",\n  \"merchantReference\": \"PAYOUT-1001\",\n  \"recipientName\": \"Jane Doe\",\n  \"phoneNumber\": \"+254712345678\",\n  \"scenario\": \"HappyPath\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payouts", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payouts" ] }
          }
        },
        {
          "name": "Initiate Payout - Bank Transfer",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"BankTransfer\",\n  \"provider\": \"Bank\",\n  \"amount\": 15000.00,\n  \"currency\": \"KES\",\n  \"merchantReference\": \"PAYOUT-1002\",\n  \"recipientName\": \"John Smith\",\n  \"bankAccountNumber\": \"1234567890\",\n  \"bankName\": \"Equity Bank\",\n  \"bankCode\": \"EQBLKENA\",\n  \"scenario\": \"HappyPath\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payouts", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payouts" ] }
          }
        },
        {
          "name": "Get Payout by Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/payouts/{{payoutId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "payouts", "{{payoutId}}" ] }
          }
        },
        {
          "name": "List Payouts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payouts?page=1&pageSize=20",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "payouts" ],
              "query": [
                { "key": "status", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get Account Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/account", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "account" ] }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Register Webhook Callback URL",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://webhook.site/your-unique-id\",\n  \"notificationType\": \"POST\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/webhooks/register", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "webhooks", "register" ] }
          }
        },
        {
          "name": "List Registered Webhooks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/webhooks", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "webhooks" ] }
          }
        }
      ]
    },
    {
      "name": "Auth (Pesapal profile)",
      "item": [
        {
          "name": "Request Bearer Token",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consumerKey\": \"pesapal_demo_consumer_key\",\n  \"consumerSecret\": \"pesapal_demo_consumer_secret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/token", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "token" ] }
          }
        }
      ]
    },
    {
      "name": "Admin / Logging",
      "item": [
        {
          "name": "View Transactions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/transactions?page=1&pageSize=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "transactions" ], "query": [ { "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" } ] }
          }
        },
        {
          "name": "View Payouts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/payouts?page=1&pageSize=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "payouts" ], "query": [ { "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" } ] }
          }
        },
        {
          "name": "View Webhook Deliveries",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/webhooks?page=1&pageSize=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "webhooks" ], "query": [ { "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" } ] }
          }
        },
        {
          "name": "View Errors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/errors?page=1&pageSize=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "errors" ], "query": [ { "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" } ] }
          }
        },
        {
          "name": "View Scenario Executions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/scenarios?page=1&pageSize=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "scenarios" ], "query": [ { "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" } ] }
          }
        },
        {
          "name": "Get Effective Configuration",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "config" ] }
          }
        },
        {
          "name": "Get Configuration History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config-history?limit=20", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "admin", "config-history" ], "query": [ { "key": "limit", "value": "20" } ] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": [ "{{baseUrl}}" ], "path": [ "health" ] }
          }
        }
      ]
    }
  ]
}
