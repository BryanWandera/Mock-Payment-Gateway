# Environment variables for PaymentMock (mock payment gateway — staging/testing only).
#
# .NET config binding uses the "Section__Key" double-underscore convention to map
# env vars onto appsettings.json. Array elements are addressed by index:
# "Section__ArrayKey__<index>__Property". Any var left blank here will bind to an
# empty string in appsettings.json, which is intentional: missing config should
# fail loudly at startup rather than silently fall back to a placeholder secret.
#
# Copy this file to `.env` (git-ignored) and fill in real values for the target
# environment. Never commit an actual `.env` file.

# --- Database -----------------------------------------------------------
# Full MySQL connection string, e.g.:
# Server=mysql;Port=3306;Database=paymentmock;Uid=paymentmock;Pwd=<pwd>;AllowPublicKeyRetrieval=true;SslMode=None;
Database__ConnectionString=

# --- Webhooks -------------------------------------------------------------
# HMAC secret used to sign outgoing webhook payloads. Must be a strong random
# value in any shared environment (staging included) — never the literal
# "change-me-webhook-signing-secret" placeholder that used to live in appsettings.json.
Webhooks__SignatureSecret=

# --- Authentication: Generic gateway profile API keys ----------------------
# Array-bound entries. Add more by incrementing the index (…__1__Key, …__1__Name, etc).
Authentication__ApiKeys__0__Key=
Authentication__ApiKeys__0__Name=

# --- Authentication: Pesapal gateway profile consumer keys -----------------
Authentication__PesapalConsumerKeys__0__ConsumerKey=
Authentication__PesapalConsumerKeys__0__ConsumerSecret=

# --- Gateway public base URL ------------------------------------------------
# The URL this gateway is reachable at from a browser/phone/emulator for
# hosted-checkout-style redirects. This is DIFFERENT from the internal
# server-to-server address (e.g. http://mock-payment-gateway:8080) used by the
# sibling Romeo API container — that address is not browser-reachable.
#
# Staging value must be:
#   https://mockpay.staging.yumbatech.com
Gateway__PublicBaseUrl=
