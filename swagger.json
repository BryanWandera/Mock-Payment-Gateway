  "components": {
    "schemas": {
      "CardPaymentRequest": {
        "required": [
          "amount",
          "cardNumber",
          "currency",
          "cvv",
          "expiryMonth",
          "expiryYear",
          "merchantReference",
          "provider"
        ],
        "type": "object",
        "properties": {
          "cardNumber": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/PaymentProvider"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "merchantReference": {
            "minLength": 1,
            "type": "string"
          },
          "expiryMonth": {
            "minLength": 1,
            "type": "string"
          },
          "expiryYear": {
            "minLength": 1,
            "type": "string"
          },
          "cvv": {
            "minLength": 1,
            "type": "string"
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "customerEmail": {
            "type": "string",
            "nullable": true
          },
          "scenario": {
            "type": "string",
            "nullable": true
          },
          "callbackUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MobileMoneyPaymentRequest": {
        "required": [
          "amount",
          "currency",
          "merchantReference",
          "phoneNumber",
          "provider"
        ],
        "type": "object",
        "properties": {
          "phoneNumber": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/PaymentProvider"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "merchantReference": {
            "minLength": 1,
            "type": "string"
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "customerEmail": {
            "type": "string",
            "nullable": true
          },
          "scenario": {
            "type": "string",
            "nullable": true
          },
          "callbackUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PaymentMethod": {
        "enum": [
          "MobileMoney",
          "Card",
          "BankTransfer"
        ],
        "type": "string"
      },
      "PaymentProvider": {
        "enum": [
          "MTN",
          "Airtel",
          "Visa",
          "Mastercard",
          "Bank"
        ],
        "type": "string"
      },
      "PayoutRequest": {
        "required": [
          "amount",
          "currency",
          "merchantReference",
          "paymentMethod",
          "provider"
        ],
        "type": "object",
        "properties": {
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "provider": {
            "$ref": "#/components/schemas/PaymentProvider"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "merchantReference": {
            "minLength": 1,
            "type": "string"
          },
          "recipientName": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "bankAccountNumber": {
            "type": "string",
            "nullable": true
          },
          "bankName": {
            "type": "string",
            "nullable": true
          },
          "bankCode": {
            "type": "string",
            "nullable": true
          },
          "scenario": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PayoutStatus": {
        "enum": [
          "Created",
          "Pending",
          "Processing",
          "Completed",
          "Failed",
          "Cancelled"
        ],
        "type": "string"
      },
      "PesapalAuthTokenRequest": {
        "type": "object",
        "properties": {
          "consumerKey": {
            "type": "string",
            "nullable": true
          },
          "consumerSecret": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "TransactionStatus": {
        "enum": [
          "Created",
          "Pending",
          "Processing",
          "Completed",
          "Failed",
          "Cancelled",
          "Expired"
        ],
        "type": "string"
      },
      "WebhookDeliveryStatus": {
        "enum": [
          "Pending",
          "Sent",
          "Failed",
          "Skipped"
        ],
        "type": "string"
      },
      "WebhookRegistrationRequest": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "notificationType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "API key required for the Generic gateway profile. Example: X-API-Key: {your-key}",
        "name": "X-API-Key",
        "in": "header"
      },
      "Bearer": {
        "type": "http",
        "description": "Bearer token required for the Pesapal gateway profile. Obtain one from /api/v1/auth/token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ],
      "Bearer": [ ]
    }
  ]
}